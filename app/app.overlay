/* Ring•One Firmware · Dotstar Systems · Apache 2.0 */
/* DTS overlay: enable watchdog0 (wdt31) on nRF54LM20B */

&wdt31 {
	status = "okay";
};

/* MAX30101 heart-rate / SpO2 sensor: I2C21 on P1.03 (SDA) / P1.06 (SCL) —
 * validated on nRF54LM20DK-A hardware.
 * NOTE: P1.04 is nrf7002eb2's bucken-gpios (expansion header pin 4) —
 * do not put I2C21 there, it stops the nRF7002 from powering on and
 * Wi-Fi init fails even with the MAX30101 unplugged. P1.13/P1.05/P1.07
 * are also claimed by the shield (iovdd-ctrl / host-irq / coex grant).
 * P1.02 was tried but didn't come up reliably on the breadboard wiring;
 * P1.03 and P1.06 are free on this board and work. */
/ {
	aliases {
		heart-rate-sensor = &max30101_sensor;
	};
};

&pinctrl {
	i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 3)>,
				<NRF_PSEL(TWIM_SCL, 1, 6)>;
			bias-pull-up;
		};
	};

	i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 3)>,
				<NRF_PSEL(TWIM_SCL, 1, 6)>;
			low-power-enable;
		};
	};
};

&i2c21 {
	status = "okay";
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>; /* 400 kHz */

	max30101_sensor: max30101@57 {
		status = "okay";
		compatible = "maxim,max30101";
		reg = <0x57>;
		/* Sensor power rail settles after the rest of the board is
		 * up — deferred-init lets ringone_sensors_init() retry the
		 * bring-up sequence instead of failing a POST_KERNEL init. */
		zephyr,deferred-init;
		acq-mode = "spo2";
		/* Binding default led-pa is [0xff,0xff,0xff] (~50 mA per LED) —
		 * at ring form-factor proximity that pins the photodiode at
		 * ADC full-scale (raw reads 0x3FFFF, i.e. 32767 after the
		 * driver's data_shift), clipping the AC/pulsatile component
		 * flat and leaving heart-rate/SpO2 stuck at 0.
		 *
		 * led-pa=0x24 (previous value) stopped the saturation, but
		 * ringone_ppg debug logging on hardware showed the real
		 * pulsatile AC settles at only ~9-13 counts against a ~7460
		 * DC baseline once contact stabilises — ~0.15% modulation,
		 * over 10x below MIN_AC_RMS_COUNTS (150). DC is still only
		 * ~23% of the way to the saturation ceiling there, but AC
		 * scales with DC, so LED current alone tops out around
		 * ~55-60 counts even pushed to the saturation edge — not
		 * enough by itself.
		 *
		 * led-pw's default (69 us) only gives 15-bit resolution, so
		 * the driver's data_shift discards the bottom 3 raw bits.
		 * 411 us (18-bit, data_shift=0) recovers those for free — an
		 * 8x count gain with no extra LED current or noise. Paired
		 * with a smaller led-pa bump for margin, this should clear
		 * the AC threshold while keeping steady-state DC well under
		 * the (now finer-grained) saturation ceiling. Retune against
		 * `ringone spo2` on actual hardware. */
		led-pw = <411>;
		led-pa = [60 60 00];
	};
};
