/* Ring•One Firmware · Dotstar Consulting · Apache 2.0 */
/* DTS overlay: enable watchdog0 (wdt31) on nRF54LM20A */

&wdt31 {
	status = "okay";
};

/* MAX30101 heart-rate / SpO2 sensor: I2C21 on P1.03 (SDA) / P1.06 (SCL) —
 * validated on nRF54LM20DK-A hardware.
 * NOTE: P1.04 is nrf7002eb2's bucken-gpios (expansion header pin 4) —
 * do not put I2C21 there, it stops the nRF7002 from powering on and
 * Wi-Fi init fails even with the MAX30101 unplugged. P1.13/P1.05/P1.07
 * are also claimed by the shield (iovdd-ctrl / host-irq / coex grant).
 * P1.02 was tried but didn't come up reliably on the breadboard wiring;
 * P1.03 and P1.06 are free on this board and work. */
/ {
	aliases {
		heart-rate-sensor = &max30101_sensor;
	};
};

&pinctrl {
	i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 3)>,
				<NRF_PSEL(TWIM_SCL, 1, 6)>;
			bias-pull-up;
		};
	};

	i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 3)>,
				<NRF_PSEL(TWIM_SCL, 1, 6)>;
			low-power-enable;
		};
	};
};

&i2c21 {
	status = "okay";
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>; /* 400 kHz */

	max30101_sensor: max30101@57 {
		status = "okay";
		compatible = "maxim,max30101";
		reg = <0x57>;
		/* Sensor power rail settles after the rest of the board is
		 * up — deferred-init lets ringone_sensors_init() retry the
		 * bring-up sequence instead of failing a POST_KERNEL init. */
		zephyr,deferred-init;
		acq-mode = "spo2";
	};
};
