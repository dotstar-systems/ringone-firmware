# Ring•One Firmware · Dotstar Systems · Apache 2.0
# Ring-One application Kconfig — sourced from app/Kconfig

config RINGONE_CLOUD_ENABLE
	bool "Enable Wi-Fi provisioning + cloud telemetry"
	default y
	help
	  Disable for BLE-only local bench testing: skips wifi_prov_init(),
	  sntp_sync(), influx_telemetry_init(), ringone_mqtt_init(), and the
	  periodic InfluxDB/MQTT publish — no Wi-Fi AP or cloud broker needed.
	  BLE advertising, GATT notifications and sensor reads are unaffected.
	  Build with: -DCONFIG_RINGONE_CLOUD_ENABLE=n

config RINGONE_TELEMETRY_INTERVAL_SEC
	int "MQTT telemetry publish interval seconds"
	default 30
	range 10 300
	help
	  How often to publish telemetry over MQTT (PATH C). MQTT stays
	  connected persistently, so this mainly trades data resolution vs
	  battery/airtime — it doesn't pay a new handshake per publish.
	  TWT sleep cycle on nRF7002 is tuned to this interval.

config RINGONE_INFLUX_INTERVAL_SEC
	int "InfluxDB publish interval seconds"
	default 1
	range 1 300
	help
	  How often to publish telemetry directly to InfluxDB over HTTPS
	  (PATH B). Decoupled from RINGONE_TELEMETRY_INTERVAL_SEC (MQTT)
	  since the two paths have very different per-publish cost: MQTT
	  reuses one long-lived connection, while PATH B pays a TCP+TLS
	  handshake for the first write and then reuses that connection
	  too (see influx_telemetry.c) — but a stale/closed connection
	  still costs one reconnect. Note this only changes how often the
	  *last known* sensor reading is posted; the reading itself is
	  still refreshed on the 2 s notify_work_handler cadence in
	  main.c, so it will not surface faster than that.

config RINGONE_SNTP_SERVER
	string "SNTP server hostname or IP"
	default "pool.ntp.org"
	help
	  NTP source for sntp_sync.c's time sync. Accepts a hostname or a
	  literal IP (sntp_simple() resolves either via getaddrinfo).
	  Override for offline/local-network demos where pool.ntp.org isn't
	  reachable — after sntp_thread_fn()'s retries are exhausted,
	  sntp_get_unix_time() falls back to a raw uptime counter (not a
	  real Unix timestamp), which corrupts the "ts" field in every
	  InfluxDB/MQTT publish until a sync eventually succeeds.

config RINGONE_INFLUX_HOST
	string "InfluxDB Cloud hostname"
	default "eu-central-1-1.aws.cloud2.influxdata.com"
	help
	  InfluxDB Cloud v3 write endpoint hostname.

config RINGONE_INFLUX_ORG
	string "InfluxDB organisation name"
	default "dotstar"
	help
	  InfluxDB organisation name.  Provisioned once via shell; device uses
	  runtime token from PSA Protected Storage for auth.

config RINGONE_INFLUX_BUCKET
	string "InfluxDB bucket name"
	default "ringone"
	help
	  InfluxDB bucket to write telemetry into (30 day retention recommended).

config RINGONE_MQTT_BROKER_HOST
	string "HiveMQ Cloud broker hostname"
	default "722d06c149744771bf2b3503827b63ae.s1.eu.hivemq.cloud:8883"
	help
	  HiveMQ Cloud free-tier broker hostname.
	  Format: <cluster-id>.s1.<region>.hivemq.cloud
	  Override with your real hostname; production devices get credentials
	  from PSA Protected Storage, not Kconfig.

config RINGONE_MQTT_BROKER_PORT
	int "MQTT broker TLS port"
	default 8883

config RINGONE_MQTT_USERNAME
	string "MQTT broker username (dev default only)"
	default "ringone-firmware"
	help
	  Dev-only default.  Production devices use credentials written to
	  PSA Protected Storage by the factory provisioning tool.

config RINGONE_MQTT_PASSWORD
	string "MQTT broker password (dev default only)"
	default ""
	help
	  Dev-only default.  Leave empty in production — credentials stored in
	  PSA Protected Storage (CRACEN HUK-encrypted, never plaintext in flash).

config RINGONE_SOFTAP_SSID
	string "SoftAP provisioning network name"
	default "dotstar-ringone-setup"
	help
	  SSID broadcast by the nRF54LM20B when in SoftAP provisioning mode.

config RINGONE_SOFTAP_TIMEOUT_SEC
	int "SoftAP auto-shutdown timeout seconds"
	default 300
	range 60 900
	help
	  If no Wi-Fi credentials are received via SoftAP within this period,
	  SoftAP stops automatically to conserve battery.

config RINGONE_WIFI_RECONNECT_DELAY_SEC
	int "Wi-Fi reconnect backoff delay seconds"
	default 30
