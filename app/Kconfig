source "Kconfig.zephyr"

config RINGONE_MQTT_BROKER_HOST
	string "HiveMQ Cloud broker hostname"
	default "722d06c149744771bf2b3503827b63ae.s1.eu.hivemq.cloud"
	help
	  HiveMQ Cloud free tier broker hostname.
	  Format: <cluster-id>.s1.<region>.hivemq.cloud

config RINGONE_MQTT_BROKER_PORT
	int "MQTT broker TLS port"
	default 8883

config RINGONE_MQTT_USERNAME
	string "MQTT broker username"
	default "ringone-firmware"
	help
	  HiveMQ Cloud username. Dev-only default — production devices use
	  credentials written to PSA Protected Storage by the factory
	  provisioning tool via wifi_telemetry_provision_mqtt_creds().

config RINGONE_MQTT_PASSWORD
	string "MQTT broker password"
	default "Dotstar1"
	help
	  HiveMQ Cloud password. Dev-only default — production devices use
	  credentials written to PSA Protected Storage (CRACEN HUK-encrypted)
	  by the factory provisioning tool.

config RINGONE_TELEMETRY_INTERVAL_SEC
	int "Telemetry publish interval in seconds"
	default 30
	range 10 300
	help
	  How often to publish telemetry to MQTT broker.
	  30s default balances data resolution vs battery.
	  Lower values drain battery faster.
	  TWT sleep cycle on nRF7002 is tuned to this interval.

config RINGONE_WIFI_RECONNECT_DELAY_SEC
	int "Wi-Fi reconnect backoff delay seconds"
	default 30
